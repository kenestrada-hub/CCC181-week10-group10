{
  "openapi": "3.0.3",
  "info": { "title": "CampusConnect API", "version": "1.0.0", "description": "CCC181 Group 10 IT-3A. Fixed Week 12–13 authentication contract; events are design only." },
  "servers": [{ "url": "http://localhost:3000/api/v1" }],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health", "summary": "Check API availability",
        "responses": { "200": { "description": "API is running", "content": { "application/json": { "schema": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["ok"] } }, "additionalProperties": false }, "example": { "status": "ok" } } } } }
      }
    },
    "/sessions": {
      "post": {
        "operationId": "createSession", "summary": "Log in with the demo account",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["email", "password"], "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string", "minLength": 1, "writeOnly": true } } }, "example": { "email": "student@campusconnect.test", "password": "Campus26" } } }
        },
        "responses": {
          "200": { "description": "Authenticated; token expires in one hour", "content": { "application/json": { "schema": { "type": "object", "required": ["token", "user"], "properties": { "token": { "type": "string" }, "user": { "$ref": "#/components/schemas/User" } }, "additionalProperties": false }, "example": { "token": "<signed JWT>", "user": { "id": 1, "name": "Demo Student", "email": "student@campusconnect.test" } } } } },
          "400": { "description": "Missing or malformed credentials / malformed JSON", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Email and password are required." } } } },
          "401": { "description": "Unknown email or incorrect password; identical message", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Invalid email or password." } } } },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/users/me": {
      "get": {
        "operationId": "getCurrentUser", "summary": "Get the authenticated public user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Authenticated user; no password/hash", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" }, "example": { "id": 1, "name": "Demo Student", "email": "student@campusconnect.test" } } } },
          "401": { "description": "Token is missing, invalid, expired or has an unknown user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Not logged in." } } } },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "schemas": {
      "User": { "type": "object", "required": ["id", "name", "email"], "properties": { "id": { "type": "integer", "example": 1 }, "name": { "type": "string", "example": "Demo Student" }, "email": { "type": "string", "format": "email", "example": "student@campusconnect.test" } }, "additionalProperties": false },
      "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "string" } }, "additionalProperties": false }
    },
    "responses": {
      "ServerError": { "description": "Unexpected error; no stack traces", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Something went wrong." } } } }
    }
  }
}
